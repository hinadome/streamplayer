{
  "name": "streamplayer",
  "version": "1.1.0",
  "description": "Web-based stream player supporting MP4/HLS/DASH/CMAF with custom headers and diagnostics",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dashjs": "4.7.4",
    "express": "4.22.3",
    "hls.js": "1.5.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
